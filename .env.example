# Web runtime config (current web app is Vite-based).
# In Vite, only vars prefixed with VITE_ are exposed to the browser.

VITE_APP_NAME=Fordan Solar CRM
VITE_APP_ENV=development

# API
VITE_API_BASE_URL=http://localhost:3000
VITE_API_LOGIN_PATH=/api/login
VITE_API_TIMEOUT_MS=15000

